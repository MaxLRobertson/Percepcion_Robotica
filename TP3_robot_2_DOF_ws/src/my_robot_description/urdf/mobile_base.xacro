<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Parámetros generales -->
  <xacro:arg name="package_name" default="my_robot_description"/>
  <xacro:arg name="mesh_dir" default="meshes"/>


  <!-- Escala global del modelo CAD exportado desde SolidWorks -->
  <xacro:property name="global_scale" value="0.02"/>


  <!-- Cuerpo del Tanque -->
  <xacro:property name="base_mesh" value="tank_body_max.stl"/>
  <xacro:property name="base_scale" value="${global_scale} ${global_scale} ${global_scale}"/>
  <xacro:property name="base_visual_xyz" value="0 0 0"/>
  <xacro:property name="base_visual_rpy" value="0 0 0"/>



  <!-- Torreta -->
  <xacro:property name="tank_head_mesh" value="tank_head_max.stl"/>
  <xacro:property name="tank_head_scale" value="${global_scale} ${global_scale} ${global_scale}"/>
  <xacro:property name="tank_head_xyz" value="0 0 ${25 * global_scale}"/>
  <xacro:property name="tank_head_rpy" value="0 0 0"/>
  <xacro:property name="tank_head_axis" value="0 0 1"/>
  <xacro:property name="tank_head_visual_xyz" value="0 0 ${-25 * global_scale}"/>
  <xacro:property name="tank_head_visual_rpy" value="0 0 0"/>



  <!-- Canon -->
  <xacro:property name="tank_gun_mesh" value="tank_gun_max.stl"/>
  <xacro:property name="tank_gun_scale" value="${global_scale} ${global_scale} ${global_scale}"/>
  <xacro:property name="tank_gun_xyz" value="0 ${-19 * global_scale} ${5 * global_scale}"/>
  <xacro:property name="tank_gun_rpy" value="0 0 0"/>
  <xacro:property name="tank_gun_axis" value="1 0 0"/>
  <xacro:property name="tank_gun_visual_xyz" value="0 ${19 * global_scale} ${-30 * global_scale}"/>
  <xacro:property name="tank_gun_visual_rpy" value="0 0 0"/>





  <!-- Macro Unificada para Links (Evita repetir código de forma errónea) -->
  <!-- No use las o_xyz y o_rpy, habria que ver que fallo -->

  <xacro:macro name="mesh_link" params="name mesh scale v_xyz v_rpy o_xyz o_rpy material mass:=0.00000001 collision_type width:=0.00000001 height:=0.00000001 depth:=0.00000001 radius:=0.00000001">
    <link name="${name}">
      <visual>
        <origin xyz="${v_xyz}" rpy="${v_rpy}"/>
        <geometry>
          <mesh filename="package://$(arg package_name)/$(arg mesh_dir)/${mesh}" scale="${scale}"/>
        </geometry>
        <material name="${material}"/>
      </visual>

      <!-- Elemento Inercial (Asume siempre forma de caja para el cálculo) Creo que quedaron mal puestos los depth y height pero ya fue -->
      <inertial>
        <origin xyz="${v_xyz}" rpy="${v_rpy}"/>
        <mass value="${mass}"/>
        <inertia 
          ixx="${(1/12) * mass * (height*height + depth*depth)}" ixy="0.0" ixz="0.0"
          iyy="${(1/12) * mass * (width*width + depth*depth)}" iyz="0.0"
          izz="${(1/12) * mass * (width*width + height*height)}" />
      </inertial>

      <!-- Elemento de Colisión Dinámico -->
      <collision>
        <origin xyz="${v_xyz}" rpy="${v_rpy}"/>
        <geometry>
          
          <!-- Opción 1: Si el tipo es 'box' -->
          <xacro:if value="${collision_type == 'box'}">
            <box size="${width} ${height} ${depth}"/>
          </xacro:if>
          
          <!-- Opción 2: Si el tipo es 'sphere' -->
          <xacro:if value="${collision_type == 'sphere'}">
            <sphere radius="${radius}"/>
          </xacro:if>
          
        </geometry>
      </collision>

    </link>
  </xacro:macro>



  <!-- Instancias de Links -->

  <link name="base_footprint"/>
  <!-- <inertial>
    <mass value="0.001"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
  </inertial>
  </link> -->


  <xacro:mesh_link
    name="base_link"
    mesh="${base_mesh}"
    scale="${base_scale}"
    v_xyz="${base_visual_xyz}"
    v_rpy="${base_visual_rpy}"
    o_xyz="${base_visual_xyz}"
    o_rpy="${base_visual_rpy}"
    material="blue"
    mass="0.12"
    collision_type="box"
    width="0.21"
    height="0.15"
    depth="0.06"/>


  <xacro:mesh_link
    name="tank_head_link"
    mesh="${tank_head_mesh}"
    scale="${tank_head_scale}"
    v_xyz="${tank_head_visual_xyz}"
    v_rpy="${tank_head_visual_rpy}"
    o_xyz="${tank_head_xyz}"
    o_rpy="${tank_head_rpy}"
    material="grey"
    mass="0.1403"
    collision_type="sphere"
    width="0.066"
    height="0.066"
    depth="0.025"
    radius="0.033"/>


  <xacro:mesh_link
    name="tank_gun_link"
    mesh="${tank_gun_mesh}"
    scale="${tank_gun_scale}"
    v_xyz="${tank_gun_visual_xyz}"
    v_rpy="${tank_gun_visual_rpy}"
    o_xyz="${tank_gun_xyz}"
    o_rpy="${tank_gun_rpy}"
    material="grey"
    mass="0.1403"
    collision_type="sphere"
    width="0.066"
    height="0.066"
    depth="0.025"
    radius="0.033"/>


<!-- ================================================================================================================== -->



  <!-- Joints -->

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- <joint name="tank_head_joint" type="continuous"> -->
  <joint name="tank_head_joint" type="revolute">
    <origin xyz="${tank_head_xyz}" rpy="${tank_head_rpy}"/>
    <parent link="base_link"/>
    <child link="tank_head_link"/>
    <axis xyz="${tank_head_axis}"/>
    <limit lower="${radians(-160)}" upper="${radians(160)}" effort="9999.0" velocity="9999.0"/>
  </joint>


  <joint name="tank_gun_joint" type="revolute">
    <origin xyz="${tank_gun_xyz}" rpy="${tank_gun_rpy}"/>
    <parent link="tank_head_link"/>
    <child link="tank_gun_link"/>
    <axis xyz="${tank_gun_axis}"/>
    <limit lower="${radians(-15)}" upper="${radians(45)}" effort="9999.0" velocity="9999.0"/>
  </joint>


</robot>










