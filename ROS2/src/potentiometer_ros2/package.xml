<?xml version="1.0"?>
<package format="3">
  <name>potentiometer_ros2</name>
  <version>0.1.0</version>
  <description>Dashboard y registro del potenciómetro publicado por micro-ROS.</description>
  <maintainer email="alumno@example.com">Grupo TP2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
